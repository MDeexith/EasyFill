{
  "info": {
    "name": "EasyFill Backend API Tests",
    "description": "Tests every application endpoint exposed by backend_py/main.py. Set base_url to your server (default http://localhost:3001), start the backend with OPENROUTER_API_KEY, and run the collection. Run from the repository root so Postman can read backend_py/fixtures/sample-resume.pdf; if Postman cannot resolve it, select that PDF manually in the Parse Resume requests. Increase the Postman request timeout to at least 90000 ms for OpenRouter calls and slower job-source requests. Source endpoints may return empty job arrays when upstream services have no results or are unavailable; tests check API response shape rather than requiring a minimum count. POST /jobs/companies adds a sample handle to the in-memory company list, and POST /jobs/refresh clears the in-memory JobSpy cache. The /docs, /redoc and /openapi.json URLs are FastAPI documentation endpoints and are included too.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "search",
      "value": "engineer",
      "type": "string"
    },
    {
      "key": "greenhouse_company",
      "value": "stripe",
      "type": "string"
    },
    {
      "key": "new_company",
      "value": "postman-example-board",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response is JSON\", function () { pm.response.json(); });",
                  "var data = pm.response.json();",
                  "pm.test(\"Server is healthy\", function () { pm.expect(data.status === \"ok\").to.eql(true); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "OpenRouter",
      "item": [
        {
          "name": "POST /match/",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/match/",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fields\": [\n    {\n      \"id\": \"email\",\n      \"name\": \"email\",\n      \"label\": \"Email address\",\n      \"type\": \"email\"\n    },\n    {\n      \"id\": \"first_name\",\n      \"name\": \"firstName\",\n      \"label\": \"First name\",\n      \"type\": \"text\"\n    }\n  ],\n  \"profile\": {\n    \"firstName\": \"Jane\",\n    \"lastName\": \"Doe\",\n    \"email\": \"jane@example.com\",\n    \"phone\": \"+1-555-000-1234\",\n    \"linkedIn\": \"https://linkedin.com/in/janedoe\",\n    \"currentTitle\": \"Software Engineer\",\n    \"skills\": \"Python, React\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response is JSON\", function () { pm.response.json(); });",
                  "var data = pm.response.json();",
                  "pm.test(\"mapping is object\", function () { pm.expect(typeof data.mapping === \"object\").to.eql(true); });",
                  "pm.test(\"decisions is object\", function () { pm.expect(typeof data.decisions === \"object\").to.eql(true); });",
                  "pm.test(\"Mapping and decisions have the same field IDs\", function () { pm.expect(Object.keys(data.mapping).every(function (id) { return data.decisions[id] && data.decisions[id].key === data.mapping[id]; })).to.eql(true); });",
                  "pm.test(\"Email field maps to email\", function () { pm.expect(data.mapping.email === \"email\").to.eql(true); });",
                  "pm.test(\"First name field maps to firstName\", function () { pm.expect(data.mapping.first_name === \"firstName\").to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /generate/",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/generate/",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
