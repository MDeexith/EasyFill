              "raw": "{\n  \"items\": [\n    {\n      \"fieldId\": \"work_auth\",\n      \"label\": \"Work authorization\",\n      \"profileKey\": \"workAuthorization\",\n      \"profileValue\": \"Yes\",\n      \"options\": [\n        {\n          \"value\": \"yes\",\n          \"label\": \"Yes\"\n        },\n        {\n          \"value\": \"no\",\n          \"label\": \"No\"\n        }\n      ]\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
