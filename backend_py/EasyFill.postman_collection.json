          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response is JSON\", function () { pm.response.json(); });",
                  "var data = pm.response.json();",
                  "pm.test(\"Selections is an object\", function () { pm.expect(data.selections !== null && typeof data.selections === \"object\" && !Array.isArray(data.selections)).to.eql(true); });",
                  "pm.test(\"Each selection is a string\", function () { pm.expect(Object.values(data.selections).every(function (value) { return typeof value === \"string\"; })).to.eql(true); });",
                  "pm.test(\"Work authorization selects Yes\", function () { pm.expect(data.selections.work_auth === \"Yes\").to.eql(true); });"
                ]
