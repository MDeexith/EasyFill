              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response is JSON\", function () { pm.response.json(); });",
                  "var data = pm.response.json();",
                  "pm.test(\"Generated text is a nonempty string\", function () { pm.expect(typeof data.text === \"string\" && data.text.trim().length > 0).to.eql(true); });"
                ]
