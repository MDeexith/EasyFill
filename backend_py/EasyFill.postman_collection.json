      "name": "Jobs - Feed",
      "item": [
        {
          "name": "GET /jobs/feed (selected sources)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/jobs/feed?page=1&country=in&sources=jobicy%2Cremotive",
            "description": "Uses two API sources so a collection run does not start all JobSpy scrapers."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response is JSON\", function () { pm.response.json(); });",
                  "var data = pm.response.json();",
                  "pm.test(\"Jobs array\", function () { pm.expect(Array.isArray(data.jobs)).to.eql(true); });",
                  "pm.test(\"Pagination\", function () { pm.expect(typeof data.total === \"number\" && data.page === 1 && data.perPage === 10 && typeof data.hasMore === \"boolean\").to.eql(true); });",
                  "pm.test(\"Page length\", function () { pm.expect(data.jobs.length <= data.perPage && data.total >= data.jobs.length).to.eql(true); });"
                ]
